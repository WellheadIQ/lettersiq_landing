---
import { createPen } from "../../lib/ink.js";

const tiers = [
  { name: "Essential", scope: "Up to 100 leases", price: "$399", cadence: "per month", body: "For single-basin operators who need the whole RRC picture without a compliance team." },
  { name: "Operator", scope: "Up to 500 leases", price: "$999", cadence: "per month", body: "For multi-field operators where one severance can interrupt revenue across several counties.", featured: true },
  { name: "Enterprise", scope: "500+ leases", price: "Custom", cadence: "priced to portfolio", body: "For large portfolios, acquisition diligence, and teams that run LettersIQ alongside their own systems." },
];

const included = [
  "Daily briefing at 7:00 AM CT",
  "Severance, seal and certified-letter alerts",
  "P-5 renewal countdown and Rule 15 milestones",
  "Proration delinquency and allowable changes",
  "Commingle blast-radius monitoring",
  "Drilling-permit expiry and P-4 changes",
  "Connected records and next-step guidance",
  "Every lease in the plan, no per-seat fees",
];

const red = createPen(707, { wobble: 1.3 });
const ring = red.circle(100, 44, 94, 36, { turns: 1.14, start: -2.5, tilt: -0.05 });
const pen = createPen(708, { wobble: 0.9 });
const checks = included.map(() => pen.poly([[3, 11], [8, 16], [19, 3]]));
---
<section class="section pricing" id="pricing" aria-labelledby="pricing-heading">
  <div class="shell">
    <header class="section-head section-head--split">
      <div>
        <p class="fig-label">Fig. 06 · Rates</p>
        <h2 id="pricing-heading" class="section-title" data-reveal>
          Priced on the portfolio <em>you operate.</em>
        </h2>
      </div>
      <p class="section-lede" data-reveal>
        Every system, every alert and every briefing comes with every plan.
        You choose how many leases it watches. Annual billing is available,
        and monitoring starts once your operator is set up.
      </p>
    </header>

    <div class="rates">
      {tiers.map((t) => (
        <article class={`rate ${t.featured ? "is-featured" : ""}`} data-reveal>
          <header class="rate-head">
            <h3 class="rate-name">{t.name}</h3>
            {t.featured && <span class="rate-flag">Most operators</span>}
          </header>
          <p class="rate-scope">{t.scope}</p>
          <p class="rate-price">
            <span class="rate-amount">
              {t.price}
              {t.featured && (
                <svg class="rate-ring" viewBox="0 0 200 88" preserveAspectRatio="none" aria-hidden="true" data-draw-on-view>
                  <path class="ink-r" d={ring} />
                </svg>
              )}
            </span>
            <span class="rate-cadence">{t.cadence}</span>
          </p>
          <p class="rate-body">{t.body}</p>
          <a class={`btn ${t.featured ? "btn-red" : "btn-line"} rate-cta`} href="#contact">
            Check my operator <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>

    <div class="included" data-reveal>
      <p class="included-head">Included in every plan</p>
      <ul class="included-list">
        {included.map((item, i) => (
          <li>
            <svg viewBox="0 0 22 20" aria-hidden="true" data-draw-on-view><path class="ink-r" d={checks[i]} /></svg>
            {item}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
