---
import { createPen } from "../../lib/ink.js";
import HairlinePlate from "./HairlinePlate.astro";
import briefingEmail from "../../assets/images/liq-daily-briefing-email.jpg";

const items = [
  {
    sev: "critical",
    label: "Critical",
    consequence: "Production at risk · 3 leases",
    title: "Commingle blast radius (3rd-party severance)",
    record: "Certified letter filed 02:14 on Lease 08-10977 (Halvorsen Energy), a co-member on your P-17 permit.",
    next: "Call the co-member and confirm a cure before an order issues.",
  },
  {
    sev: "high",
    label: "High",
    consequence: "Production at risk · 14 days",
    title: "P-5 expiration approaching",
    record: "Organization report expires Oct 6.",
    next: "File the P-5 renewal.",
  },
  {
    sev: "medium",
    label: "Medium",
    consequence: "Allowable blocked",
    title: "Allowable blocked (checklist)",
    record: "Well 08-11234 #3: no W-2 completion report or L-1 log on file.",
    next: "File the W-2 and L-1.",
  },
  {
    sev: "medium",
    label: "Medium",
    consequence: "Allowable at risk",
    title: "Proration status change",
    record: "DLQ W-10 on 3 wells, Lease 08-11102.",
    next: "File the W-10 retest.",
  },
  {
    sev: "low",
    label: "Low",
    consequence: "Permit lapses · 22 days",
    title: "Drilling permit expiring (not drilled)",
    record: "W-1 approved Oct 14, 2024. No spud on the wellbore record.",
    next: "Confirm the spud schedule.",
  },
  {
    sev: "resolved",
    label: "Resolved",
    consequence: "Back in business",
    title: "Severance resolved",
    record: "Order on Lease 08-09112 lifted Sep 21.",
    next: "Nothing to do.",
  },
];

const red = createPen(505, { wobble: 1.3 });
const arrows = {
  rank: red.arrow(8, 10, 118, 64, { bend: -0.3, head: 9 }),
  record: red.arrow(112, 12, 10, 58, { bend: 0.3, head: 9 }),
  next: red.arrow(112, 50, 8, 16, { bend: -0.25, head: 9 }),
  resolved: red.arrow(10, 12, 116, 46, { bend: 0.28, head: 9 }),
};
const ring = red.circle(50, 20, 48, 17, { turns: 1.14, start: -2.4 });
---
<section class="section briefing" id="briefing" aria-labelledby="briefing-heading">
  <div class="shell">
    <header class="section-head section-head--split">
      <div>
        <p class="fig-label">Fig. 06 · The artifact</p>
        <h2 id="briefing-heading" class="section-title" data-reveal>
          One page at 7:00 AM, <em>ranked by what it can stop.</em>
        </h2>
      </div>
      <div class="section-lede" data-reveal>
        <p>
          Every finding is written the same way: the consequence first, then
          the record behind it, then the next step. Nobody has to re-derive
          anything before the first cup of coffee.
        </p>
        <a class="text-link" href={briefingEmail} target="_blank" rel="noopener noreferrer">
          See a real briefing email <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span>
        </a>
      </div>
    </header>

    <div class="sheet-wrap">
      <article class="sheet" aria-label="Sample LettersIQ morning briefing" data-sheet>
        <header class="sheet-head">
          <p class="sheet-brand">Letters<span>IQ</span></p>
          <p class="sheet-date">Morning briefing<br />Tue 22 Sep · 07:00 CT</p>
        </header>
        <p class="sheet-to">
          Brazos Bend Operating
          <span>142 leases · 8 systems read overnight</span>
        </p>
        <dl class="sheet-stats">
          <div><dt>Changes</dt><dd>6</dd></div>
          <div class="is-critical">
            <dt>Critical</dt>
            <dd>
              1
              <svg class="sheet-ring" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true" data-draw-on-view><path class="ink-r" d={ring} /></svg>
            </dd>
          </div>
          <div><dt>Resolved</dt><dd>1</dd></div>
        </dl>
        <ol class="sheet-items">
          {items.map((item) => (
            <li class={`sheet-item is-${item.sev}`} data-sheet-item>
              <p class="sheet-sev"><span class="sr-only">Severity: </span>{item.label}</p>
              <div class="sheet-body">
                <p class="sheet-consequence">{item.consequence}</p>
                <h3 class="sheet-title">{item.title}</h3>
                <p class="sheet-record">{item.record}</p>
                <p class="sheet-next"><span>Next</span>{item.next}</p>
              </div>
            </li>
          ))}
        </ol>
        <footer class="sheet-foot">Illustrative portfolio · public Texas RRC records</footer>
      </article>

      <div class="notes" aria-hidden="true">
        <div class="note note--rank">
          <p>ranked by what it can stop</p>
          <svg viewBox="0 0 124 72" data-draw-on-view><path class="ink-r" d={arrows.rank} /></svg>
        </div>
        <div class="note note--record">
          <p>the record behind it, even when the lease isn't yours</p>
          <svg viewBox="0 0 124 72" data-draw-on-view><path class="ink-r" d={arrows.record} /></svg>
        </div>
        <div class="note note--next">
          <p>and what to do about it</p>
          <svg viewBox="0 0 124 72" data-draw-on-view><path class="ink-r" d={arrows.next} /></svg>
        </div>
        <div class="note note--resolved">
          <p>cleared records close themselves</p>
          <svg viewBox="0 0 124 72" data-draw-on-view><path class="ink-r" d={arrows.resolved} /></svg>
        </div>
      </div>
    </div>

    <div class="quiet">
      <div class="quiet-plate" data-reveal>
        <HairlinePlate
          name="mailbox"
          tag="Fig. 06 · Quiet morning"
          rest="every flag down"
          label="Three rural mailboxes on one plank at a lease road, every flag down. One door stands ajar on an empty box."
        />
      </div>
      <div class="quiet-copy">
        <p class="fig-label">Most mornings</p>
        <h3 class="quiet-title" data-reveal>Nothing changed? <em>Nothing is sent.</em></h3>
        <p class="quiet-body" data-reveal>
          If none of the eight systems moved against your leases overnight,
          there's no briefing to skim and no all-clear to file. The next email
          from LettersIQ is one worth opening.
        </p>
      </div>
    </div>
  </div>
</section>
