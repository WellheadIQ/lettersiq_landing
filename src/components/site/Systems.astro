---
import HairlinePlate from "./HairlinePlate.astro";

// `drawer` is the cabinet figure's read-out name for the system, and `at` the
// viewBox point of that drawer's front, so a row can pull its own drawer.
const systems = [
  { drawer: "severance", at: "122,110", name: "Severance & seal orders", form: "Severance", cadence: "Daily", body: "Issue, resolution and reissue records, so an active order shows up the morning it issues and the all-clear shows up the day it lifts." },
  { drawer: "certified", at: "164,131", name: "Certified letters", form: "Pre-severance", cadence: "Daily", body: "The Commission's final notice before a severance, caught the night it's filed while there's still time to cure." },
  { drawer: "proration", at: "205,152", name: "Proration schedules", form: "Oil & gas", cadence: "Daily", body: "Delinquency codes like DLQ W-10, DLQ FORM and H-15 VIOL, plus allowable changes, compared against yesterday." },
  { drawer: "p-5", at: "247,173", name: "Organization report", form: "P-5", cadence: "Weekly", body: "A 60, 30, 14 and 7-day countdown to expiry. An unrenewed P-5 can sever every lease you operate." },
  { drawer: "rule 15", at: "122,155", name: "Inactive wells", form: "Rule 15", cadence: "Weekly", body: "Five- and ten-year inactivity milestones, W-3X extension status, and wells that newly land on the aging report." },
  { drawer: "p-17", at: "164,176", name: "Surface commingling", form: "P-17", cadence: "Weekly", body: "Every co-member lease on your commingles, watched for the severance that would shut in yours." },
  { drawer: "w-1", at: "205,196", name: "Drilling permits", form: "W-1", cadence: "Weekly", body: "The two-year no-spud expiry, counted from the original approval and checked against the wellbore record." },
  { drawer: "p-4", at: "247,217", name: "Gatherers & purchasers", form: "P-4", cadence: "Weekly", body: "Lost market outlets and operator-of-record changes, the day the Commission processes them." },
];
---
<section class="section systems" id="systems" aria-labelledby="systems-heading">
  <div class="shell">
    <header class="section-head section-head--split">
      <div>
        <p class="fig-label">Fig. 04 · Coverage</p>
        <h2 id="systems-heading" class="section-title" data-reveal>
          Eight systems. <em>One reading.</em>
        </h2>
      </div>
      <p class="section-lede" data-reveal>
        An operator-number search only shows what was filed against you.
        LettersIQ reads all eight systems against every lease you run, then
        joins them, so a record in one system can surface a risk in another.
      </p>
    </header>

    <div class="systems-body">
      <div class="systems-plate" data-reveal>
        <HairlinePlate
          name="cabinet"
          tag="Fig. 04 · The cabinet"
          rest="point at a drawer"
          label="An isometric card-catalog cabinet of eight drawers, one per Railroad Commission system. The certified-letter drawer stands open."
          caption="Eight drawers, read every night. Point at one, or at a row, to pull it."
        />
      </div>

      <ol class="index" data-index>
        {systems.map((s, i) => (
          <li class="index-row" data-reveal data-hl-at={s.at} data-hl-name={s.drawer}>
            <span class="index-no">{String(i + 1).padStart(2, "0")}</span>
            <span class="index-dots" aria-hidden="true">
              {Array.from({ length: 8 }, (_, k) => <i class={k === i ? "on" : ""} />)}
            </span>
            <h3 class="index-name">
              {s.name}
              <span class="index-form">{s.form}</span>
            </h3>
            <span class={`index-cadence is-${s.cadence.toLowerCase()}`}>{s.cadence}</span>
            <p class="index-body">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
