---
import { LetterForm } from "./LetterForm.jsx";
---
<section class="section contact" id="contact" aria-labelledby="contact-heading">
  <span id="contact-us" class="anchor-alias" aria-hidden="true"></span>
  <div class="shell contact-grid">
    <header class="contact-head">
      <p class="fig-label">Fig. 08 · Check my operator</p>
      <h2 id="contact-heading" class="section-title" data-reveal>
        Write to us once. <em>We'll read the Commission for you.</em>
      </h2>
      <p class="section-lede" data-reveal>
        Send an operator name. We run your Texas portfolio through LettersIQ
        and send back what deserves attention, usually before you'd have
        finished checking the first system yourself.
      </p>
    </header>
    <LetterForm client:visible />
  </div>
</section>
