---
import Layout from "../layouts/Layout.astro";
import { Hero } from "../components/Hero.jsx";
import { Film } from "../components/Film.jsx";
import { Navbar } from "../components/Navbar.jsx";
import { Coverage } from "../components/Coverage.jsx";
import { Features1 } from "../components/Features1.jsx";
import { Testimonials } from "../components/Testimonials.jsx";
import { BlastRadius } from "../components/BlastRadius.jsx";
import { HowItWorks } from "../components/HowItWorks.jsx";
import { Pricing } from "../components/Pricing.jsx";
import { FAQ } from "../components/FAQ.jsx";
import { Footer } from "../components/Footer.jsx";
import { ScrollUpButton } from "../components/ScrollUpButton";
import { ContactUs } from "../components/ContactUs"
import "../styles/Theme.css";

---

<Layout
  title="Texas RRC Severance Alerts, Before the Letter | LettersIQ"
  primary
>
  <Navbar client:load />
  <Hero client:load />
  <!-- client:visible — the film's observer has no work to do until the section
       is near the viewport, so its JS stays off the critical path. -->
  <Film client:visible />
  <BlastRadius client:load />
  <HowItWorks client:load />
  <Coverage client:load />
  <Features1 client:load />
  <Testimonials client:load />
  <Pricing client:load />
  <FAQ client:load />
  <ContactUs client:load />
  <Footer />
  <ScrollUpButton client:load />
</Layout>
