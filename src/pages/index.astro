---
import Layout from "../layouts/Layout.astro";
import { Hero } from "../components/Hero.jsx";
import { Story3D } from "../components/Story3D.jsx";
import { Navbar } from "../components/Navbar.jsx";
import { Coverage } from "../components/Coverage.jsx";
import { Features1 } from "../components/Features1.jsx";
import { BlastRadius } from "../components/BlastRadius.jsx";
import { HowItWorks } from "../components/HowItWorks.jsx";
import { Pricing } from "../components/Pricing.jsx";
import { FAQ } from "../components/FAQ.jsx";
import { Footer } from "../components/Footer.jsx";
import { ScrollUpButton } from "../components/ScrollUpButton";
import { ContactUs } from "../components/ContactUs"
import { DialRoot } from "dialkit";
import "dialkit/styles.css";
import "../styles/Theme.css";

---

<Layout
  title="Texas RRC Regulatory Operations Intelligence | LettersIQ"
  description="LettersIQ connects eight Texas RRC systems and delivers one prioritized morning briefing: what changed, what it affects, and what needs attention."
  primary
>
  <Navbar client:load />
  <Hero client:load />
  <!-- client:load so the pinned track replaces the static fallback before the
       reader arrives; Three.js itself is still imported lazily, on idle. -->
  <Story3D client:load />
  <BlastRadius client:load />
  <HowItWorks client:load />
  <Features1 client:load />
  <Coverage client:load />
  <Pricing client:load />
  <FAQ client:load />
  <ContactUs client:load />
  <Footer />
  <ScrollUpButton client:load />
  <DialRoot
    client:only="react"
    position="bottom-right"
    theme="dark"
  />
</Layout>
