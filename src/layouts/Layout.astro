---
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "@fontsource/jetbrains-mono/600.css";
import "@fontsource/jetbrains-mono/700.css";
import "@fontsource/archivo/400.css";
import "@fontsource/archivo/500.css";
import "@fontsource/archivo/600.css";
import "@fontsource/archivo/700.css";
import "@fontsource/archivo/800.css";
import "@fontsource/archivo/900.css";
import { Analytics } from "../components/Analytics.jsx";

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href="/favicon.ico" />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content="LettersIQ monitors 8 Texas Railroad Commission datasets and connects them into one 7 AM briefing — severance, certified letters, P-5 renewals, Rule 15, proration, commingle blast radius, drilling permits, and P-4 filings. Predict and prevent shut-ins before they cost you." />
  
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-JLT6WXDYCK"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-JLT6WXDYCK');
  gtag('config', 'AW-16667114456');

</script>


<!-- Google Tag Manager -->
<script type="text/partytown">(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-TFL6VJ9B');</script>
  <!-- End Google Tag Manager -->

  <!-- Open Graph meta tags -->
  <meta property="og:title" content="LettersIQ — Stop severances before the letter" />
  <meta property="og:description" content="LettersIQ watches 8 Texas RRC datasets and connects them so a problem visible only across two systems lands as one line in your 7 AM email. Predict, prevent, and prove compliance before it costs you a shut-in." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://lettersiq.com" />
  <meta property="og:image" content="/lettersiqlogo.png" />
  
<!-- Google tag (gtag.js) -->
<script type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=G-16667114456"></script>
<script type="text/partytown">
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-16667114456');
  gtag('config', 'AW-16667114456');
</script>

  
  <title>{title}</title>
</head>
<body>
  <!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TFL6VJ9B"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
  <a href="#home" class="skip-link">Skip to content</a>
  <Analytics client:only="react" />
  <slot />
  <style is:global>
    :root {
      --canvas: #060d1b;
      --oxford: #0a1428;
      --signal-red: #c8102e;
      --cobalt: #3d6bff;
      --ink: #eaeef6;
    }

    * {
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    html {
      font-family: 'Archivo', system-ui, sans-serif;
      background-color: var(--canvas);
      overflow-x: hidden;
      scroll-behavior: smooth;
      scroll-padding-top: 7rem;
      text-rendering: optimizeLegibility;
    }

    body {
      background-color: var(--canvas);
      color: var(--ink);
      position: relative;
      overflow-x: hidden;
    }

    /* Skip-to-content — visible only on keyboard focus */
    .skip-link {
      position: fixed;
      top: 0;
      left: 50%;
      z-index: 100;
      transform: translate(-50%, -120%);
      background: var(--signal-red);
      color: #fff;
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 10px 18px;
      transition: transform 180ms cubic-bezier(0.23, 1, 0.32, 1);
    }
    .skip-link:focus-visible {
      transform: translate(-50%, 8px);
      outline: 2px solid #fff;
      outline-offset: 2px;
    }
    @media (prefers-reduced-motion: reduce) {
      .skip-link { transition: none; }
    }

    /* Monospace utility */
    .font-mono {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
    }

    /* Display face utility */
    .font-display {
      font-family: 'Archivo', system-ui, sans-serif;
    }

    /* Custom scrollbar — dark */
    ::-webkit-scrollbar {
      width: 10px;
      height: 10px;
    }
    ::-webkit-scrollbar-track {
      background: #0a1428;
    }
    ::-webkit-scrollbar-thumb {
      background: #24334f;
      border: 2px solid #0a1428;
      border-radius: 999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #3a4d70;
    }

    /* Text selection */
    ::selection {
      background: #c8102e;
      color: #fff;
    }

    /* Tighten display headings */
    h1, h2 {
      text-wrap: balance;
    }
    p {
      text-wrap: pretty;
    }
  </style>
</body>
</html>
