---
import "@fontsource/commit-mono/400.css";
import "@fontsource/commit-mono/500.css";
import "@fontsource/commit-mono/700.css";
import "@fontsource/commit-mono/400-italic.css";
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";
import "../styles/site.css";
import Seo from "../components/Seo.astro";
// The hero headline is the LCP element; preloading its face avoids a reflow
// when the serif replaces the fallback.
import serifDisplay from "@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2";
import serifItalic from "@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2";
import monoBody from "@fontsource/commit-mono/files/commit-mono-latin-400-normal.woff2";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  primary?: boolean;
  breadcrumbs?: [string, string][];
}

const { title, description, image, noindex, primary, breadcrumbs } =
  Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />

  <!-- Figures stay drawn if scripts never arrive; the timeout clears the
       pre-draw state rather than leaving the page blank. -->
  <script is:inline>
    document.documentElement.classList.add("js");
    setTimeout(function () {
      if (!document.documentElement.classList.contains("motion-ready")) {
        document.documentElement.classList.remove("js");
      }
    }, 4000);
  </script>

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="/favicon.png" />

  <link rel="preload" as="font" type="font/woff2" href={serifDisplay} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={serifItalic} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={monoBody} crossorigin />

  <link rel="preconnect" href="https://www.googletagmanager.com" />
  <link rel="dns-prefetch" href="https://www.google-analytics.com" />

  <Seo
    title={title}
    description={description}
    image={image}
    noindex={noindex}
    primary={primary}
    breadcrumbs={breadcrumbs}
  />

  <!-- Google tag (gtag.js) — GA4 + Google Ads conversions -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-JLT6WXDYCK"></script>
  <!-- is:inline keeps gtag() on window; bundled as a module it is scoped away and
       the conversion call in the contact form silently never fires. -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-JLT6WXDYCK');
    gtag('config', 'AW-16667114456');
  </script>

  <!-- Google Tag Manager -->
  <script type="text/partytown">(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-TFL6VJ9B');</script>
  <!-- End Google Tag Manager -->

  <!-- Vercel Web Analytics -->
  <script>
    import { inject } from "@vercel/analytics";
    inject();
  </script>
</head>
<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TFL6VJ9B"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
  <a href="#main-content" class="skip-link">Skip to content</a>
  <slot />
</body>
</html>
