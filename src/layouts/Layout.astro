---
import "@fontsource/space-grotesk/400.css";
import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/600.css";
import "@fontsource/space-grotesk/700.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "@fontsource/jetbrains-mono/600.css";
import "@fontsource/jetbrains-mono/700.css";
import { Analytics } from "../components/Analytics.jsx";

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <link rel="icon" href="/favicon.ico" />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content="LettersIQ for monitoring severance notifications from the Texas Railroad Commission" />
  
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-JLT6WXDYCK"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-JLT6WXDYCK');
  gtag('config', 'AW-16667114456');

</script>


<!-- Google Tag Manager -->
<script type="text/partytown">(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-TFL6VJ9B');</script>
  <!-- End Google Tag Manager -->

  <!-- Open Graph meta tags -->
  <meta property="og:title" content="LettersIQ - Automatic Notifications of RRC Violations" />
  <meta property="og:description" content="LettersIQ provides automatic notifications of violations from the Texas Railroad Commission, helping you stay compliant and avoid costly severance actions." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://lettersiq.com" />
  <meta property="og:image" content="/lettersiqlogo.png" />
  
<!-- Google tag (gtag.js) -->
<script type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=G-16667114456"></script>
<script type="text/partytown">
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-16667114456');
  gtag('config', 'AW-16667114456');
</script>

  
  <title>{title}</title>
</head>
<body>
  <!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TFL6VJ9B"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
  <Analytics client:only="react" />
  <slot />
  <style is:global>
    html {
      font-family: 'Space Grotesk', sans-serif;
      background-color: #FAFAFA;
      overflow-x: hidden;
      scroll-behavior: smooth;
    }
    
    body {
      background-color: #FAFAFA;
      color: #111111;
      position: relative;
    }
    
    /* Technical Grid Background */
    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: 
        linear-gradient(rgba(0,0,0,0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,0,0,0.03) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none;
      z-index: -1;
    }
    
    /* Monospace utility */
    .font-mono {
      font-family: 'JetBrains Mono', monospace;
    }
    
    /* Technical label styles */
    .tech-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #4B5563;
    }
    
    /* Technical border frame */
    .tech-frame {
      position: relative;
      border: 1px solid rgba(0,0,0,0.1);
    }
    
    .tech-frame::before,
    .tech-frame::after {
      content: '';
      position: absolute;
      width: 12px;
      height: 12px;
      border: 1px solid rgba(0,0,0,0.3);
    }
    
    .tech-frame::before {
      top: -1px;
      left: -1px;
      border-right: none;
      border-bottom: none;
    }
    
    .tech-frame::after {
      bottom: -1px;
      right: -1px;
      border-left: none;
      border-top: none;
    }
  </style>
</body>
</html>
